<?xml version="1.0"?>
<phpunit
	bootstrap="bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="false"
	failOnRisky="true"
	failOnWarning="true"
	convertDeprecationsToExceptions="true"
>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">.</directory>
			<exclude>./vendor</exclude>
		</testsuite>
	</testsuites>
</phpunit>
