{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.11.1.2.zip",
		"https://downloads.wordpress.org/plugin/plugin-check.2.1.0.zip",
		"./.dist/romcommerce"
	],
	"themes": [
		"https://downloads.wordpress.org/theme/storefront.4.6.2.zip"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"mappings": {
		"wp-content/romcommerce-tests": "./tests",
		"wp-content/plugins/romcommerce-previous": "./.dist/romcommerce-previous"
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp language core install ro_RO"
	}
}
