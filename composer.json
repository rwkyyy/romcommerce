{
    "name": "romcommerce/romcommerce",
    "description": "Dev tooling only (tests, coding standards, static analysis) for the RomCommerce Lite plugin. Never shipped — runtime autoloading stays hand-rolled PSR-4, see src/autoload.php.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "autoload-dev": {
        "psr-4": {
            "RomCommerce\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mockery/mockery": "^1.6",
        "php-stubs/woocommerce-stubs": "^9.0",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "i18n": [
            "wp i18n make-pot . languages/romcommerce.pot --slug=romcommerce --domain=romcommerce --exclude=vendor,tests,bin,.github,node_modules,.dist,artifacts,test-results,playwright-report --no-location",
            "wp i18n update-po languages/romcommerce.pot languages",
            "wp i18n make-mo languages",
            "wp i18n make-php languages"
        ],
        "i18n-check": "bash bin/check-i18n.sh"
    }
}
