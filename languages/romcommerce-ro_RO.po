#. Plugin Name of the plugin
msgid "RomCommerce"
msgstr "RomCommerce"

#. Plugin URI of the plugin
msgid "https://romcommerce.ro"
msgstr "https://romcommerce.ro"

#. Description of the plugin
msgid "Romanian commerce layer for WooCommerce: modular tools for compliance, checkout localisation, and Romanian-market essentials."
msgstr "Strat de comerț românesc pentru WooCommerce: instrumente modulare pentru conformitate, localizarea finalizării comenzii și elemente esențiale pentru piața din România."

#. Author of the plugin
msgid "Uprise Team"
msgstr "Uprise Team"

#. Author URI of the plugin
msgid "https://uprise.ro"
msgstr "https://uprise.ro"

msgid "RomCommerce requires WooCommerce to be installed and active."
msgstr "RomCommerce necesită ca WooCommerce să fie instalat și activ."

msgid "Your session expired. The page will reload."
msgstr "Sesiunea a expirat. Pagina se va reîncărca."

msgid "You do not have permission to do that."
msgstr "Nu ai permisiunea să faci asta."

msgid "Choose image"
msgstr "Alege imaginea"

msgid "Dashboard"
msgstr "Panou de control"

msgid "Module enabled."
msgstr "Modul activat."

msgid "Module disabled."
msgstr "Modul dezactivat."

