msgstr "Total comenzi"

msgid "Completed orders"
msgstr "Comenzi finalizate"

msgid "Processing orders"
msgstr "Comenzi în procesare"

msgid "On hold / waiting orders (on hold, pending payment and custom statuses)"
msgstr "Comenzi în așteptare (în așteptare, plată în așteptare și statusuri personalizate)"

msgid "Average order value"
msgstr "Valoarea medie a comenzii"

